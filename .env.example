# ==========================================
# SentinelForge Environment Configuration
# NOTE: Demo environment — synthetic security data only.
# NEVER commit .env with real credentials.
# ==========================================

# Application
ENVIRONMENT=development
APP_NAME=SentinelForge
APP_VERSION=1.0.0
DEBUG=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & Authentication
# Generate a strong 32+ byte random string for JWT_SECRET in production
JWT_SECRET=demo-insecure-secret-key-change-in-production-only-min32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# Default points to local Postgres or Docker container
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentinelforge
# Synchronous DB URL for Alembic migrations if needed
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/sentinelforge

# Cache & Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# AI & LLM (OpenAI API)
# Set your API key for AI investigator features
OPENAI_API_KEY=sk-demo-placeholder-not-real-api-key
OPENAI_MODEL=gpt-4o-mini
AI_INVESTIGATION_TIMEOUT_SECONDS=60

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_EVENTS=100/minute
RATE_LIMIT_AI=10/minute

# Storage & Uploads
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
